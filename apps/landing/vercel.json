{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.solarbuyside.com.br"
        }
      ],
      "destination": "https://solarbuyside.com.br/$1",
      "permanent": true
    },
    {
      "source": "/v1",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v2",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v3",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v4",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/2",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/3",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/4",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v2.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v3.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v4.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*).(png|jpg|jpeg|webp|avif|svg|ico)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*).(js|css)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/cms/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
